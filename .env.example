# Скопируйте этот файл в .env и при необходимости поменяйте значения.
PORT=3000

# Если задать DATABASE_URL (connection string от Neon/Render Postgres),
# сервер будет хранить данные в Postgres вместо локального data.sqlite.
# Оставьте пустым/закомментированным для локальной разработки без интернета.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Ключ для защищённого эндпоинта DELETE /api/patients/:id (удаление тестовых
# пациентов). Без ADMIN_KEY этот эндпоинт полностью отключён (404).
# ADMIN_KEY=придумайте-длинную-случайную-строку
